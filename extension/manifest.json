{
  "manifest_version": 3,
  "name": "Blog Bunker — Article Summarizer",
  "version": "1.0.1",
  "description": "Summarize the article you're reading and save it to your Blog Bunker Inspiration board. Operative feature.",
  "action": {
    "default_title": "Summarize with Blog Bunker",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
